{
  "SchemaDefinition": "RedfishInteroperabilityProfile.v1_10_0",
  "ProfileName": "GpuNodeAcceptanceLab",
  "ProfileVersion": "1.0.0",
  "ProfileType": "Product",
  "Purpose": "Minimum Redfish features our cluster tools rely on for an 8-GPU server: power control, GPU and NIC inventory, sensors, firmware update, logs, and BMC hardening settings. (Counts of devices are checked by other tools: interoperability profiles check presence and values, not how many.)",
