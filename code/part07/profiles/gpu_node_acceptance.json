        },
        "Processors": {
          "ReadRequirement": "Mandatory"
        },
        "Storage": {
          "ReadRequirement": "Recommended"
        },
        "LogServices": {
          "ReadRequirement": "Recommended"
        }
      },
      "ActionRequirements": {
        "Reset": {
          "ReadRequirement": "Recommended",
          "Parameters": {
            "ResetType": {
              "ReadRequirement": "Mandatory",
              "ParameterValues": [
                "ForceOff",
                "GracefulRestart",
                "GracefulShutdown",
                "On"
              ]
            }
          }
        }
      }
    },
