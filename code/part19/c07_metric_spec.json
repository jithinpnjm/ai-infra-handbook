{
  "scrape_interval_s": 30,
  "retention_s": 1296000,
  "limits": {"total_budget": 2000000},
  "reserved_for_kubernetes": 1000000,
  "families": [
    {"name": "DCGM_default_fields_26", "type": "gauge",
     "labels": {"gpu": 8}, "targets": 1300},
    {"name": "vllm:time_to_first_token_seconds", "type": "histogram", "buckets": 22,
     "labels": {"model_name": 1, "engine": 1}, "targets": 40},
    {"name": "vllm:inter_token_latency_seconds", "type": "histogram", "buckets": 22,
     "labels": {"model_name": 1, "engine": 1}, "targets": 40},
    {"name": "vllm:num_requests_waiting", "type": "gauge",
     "labels": {"model_name": 1, "engine": 1}, "targets": 40},
    {"name": "vllm:request_success_total", "type": "counter",
     "labels": {"model_name": 1, "engine": 1, "finished_reason": 4}, "targets": 40},
    {"name": "gateway_requests_total", "type": "counter",
     "labels": {"tenant": 1, "model": 5, "code": 8, "route": 5}, "targets": 4},
    {"name": "gateway_ttft_seconds", "type": "histogram", "buckets": 14,
     "labels": {"model": 5, "route": 5}, "targets": 4},
    {"name": "tenant_tokens_total", "type": "counter",
     "labels": {"tenant": 200, "model": 5, "direction": 2}, "fill": 0.2, "targets": 4}
  ]
}
